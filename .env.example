# Copy this file to .env.local and fill in your Supabase project values.
# Find these at: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# New Supabase projects use "publishable" key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older projects may still use anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# EFL crawler — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Built-in auto-sync every 30 min while npm run dev / npm run start runs (default: on when service key is set)
# EFL_CRON_ENABLED=false

# Required on Vercel — used by cron-job.org and Vercel daily cron (Authorization: Bearer <secret>)
# CRON_SECRET=your-long-random-secret
