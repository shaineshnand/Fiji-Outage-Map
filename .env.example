# Copy this file to .env.local and fill in your Supabase project values.
# Find these at: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# New Supabase projects use "publishable" key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older projects may still use anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# EFL crawler only — never commit, never use in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
